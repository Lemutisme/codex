#!/usr/bin/env python3
import os,sys
args=sys.argv[1:]
if args and args[0] in ('run','create'):
 networks=[]
 for i,arg in enumerate(args):
  if arg in ('--network','--net') and i+1<len(args):networks.append(args[i+1])
  elif arg.startswith('--network=') or arg.startswith('--net='):networks.append(arg.split('=',1)[1])
 if any(value!='none' for value in networks):raise SystemExit('This campaign admits offline containers only')
 network_args=[] if networks else ['--network','none']
 args=[args[0],*network_args,'--label','pc.luna6=procontract',*(['--label','pc.task='+os.environ['PC_TASK']] if os.environ.get('PC_TASK') else []),*args[1:]]
os.execv('/data/ProContract/research/procontract-programbench-diagnostic-20261015/tools/bin/docker',['docker','--host','unix:///data/ProContract/programbench-full-procontract-20261025/docker.sock',*args])
